.DS_Store
.env
target/
.build/
*.xcuserstate
node_modules/

# Team files are operator data: each operator keeps them under their own teams root (outside this
# repository). `scripts/dev.sh` defaults to ./teams, so keep a local one out of version control.
teams/
*.swp
*.swo

# build cache for docs/mockups/build-standalone.mjs (fetched woff2 subsets)
docs/mockups/.font-cache/

# pnpm content-addressable store, when pnpm is run with a local store-dir
.pnpm-store/

# /design-sync (Claude Design): staged converter, build output, machine state. The durable
# inputs under .design-sync/ (config.json, NOTES.md, conventions.md, previews/) are committed.
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
docs/design-system/dist/
# symlink to ui/node_modules so the converter resolves @types/react (recreate per clone; see .design-sync/NOTES.md)
docs/design-system/node_modules
