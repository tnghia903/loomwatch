<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LoomWatch.app itself under the hardened runtime (scripts/package-macos-app.sh): what
     LoomWatch.entitlements gives loomwatchd, and the microphone, which the app hears through only
     while Control-Option-Space is held at the notch. loomwatchd, which runs the agents' commands,
     is not given the microphone, and their sandbox refuses it (agent/sandbox.rs). -->
<plist version="1.0">
<dict>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
