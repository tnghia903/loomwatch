# Settings for running LoomWatch in Docker Compose (see the README). The usual way to run
# LoomWatch, ./loomwatch, needs none of this: it reads only LOOMWATCH_PORT from here.

# The complete app is published on host loopback only.
LOOMWATCH_PORT=3000

# Authenticates the container to the optional native harness runner. Use a long random value.
LOOMWATCH_HOST_RUNNER_TOKEN=replace-with-a-long-random-token
LOOMWATCH_HOST_RUNNER_ADDR=host.docker.internal:3031
LOOMWATCH_HOST_RUNNER_LISTEN=0.0.0.0:3031

# Bind-mounted data. Keep capability imports separate from credentials and the rest of $HOME.
LOOMWATCH_TEAMS_DIR=./teams
LOOMWATCH_WORKSPACES_DIR=./container/workspaces
LOOMWATCH_CAPABILITIES_DIR=./container/capabilities

# Override on Linux when your repository files are owned by a different uid/gid.
LOOMWATCH_UID=1000
LOOMWATCH_GID=1000
