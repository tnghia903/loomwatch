#!/usr/bin/env bash
# One command to set up, build, start, update and stop LoomWatch on this computer.
#
#   ./loomwatch            set up anything missing, build if the code changed, start, open the browser
#   ./loomwatch update     save a copy of the run history, download the latest version, and start
#   ./loomwatch rollback   go back to the version the last update replaced (ready-built copies)
#   ./loomwatch version    say which version this is, and whether a newer one is out
#   ./loomwatch import     bring over the run history an earlier version kept in Docker
#   ./loomwatch stop       stop LoomWatch (your teams and history are kept)
#
# The same script runs a copy of the source code, which it builds, and a ready-built copy put in
# ~/LoomWatch/app by scripts/install.sh, which carries its program in bin/ and updates from the
# newest release instead of from Git. A ready-built copy can also be updated from the app, with
# Update and restart: LoomWatch stops, this script updates it as `update` does, and starts it
# again in the same window.
#
# LoomWatch keeps its run history in one file. Earlier versions kept it in PostgreSQL, which this
# script ran in Docker; the first start after updating from one copies that history into the file.
#
# Optional settings, read from the environment:
#   LOOMWATCH_TEAMS_ROOT    where your teams live (default: ~/LoomWatch/teams)
#   LOOMWATCH_PORT          browser port (default: LOOMWATCH_PORT in .env, else 3000)
#   LOOMWATCH_DATABASE      the file that holds the run history (see database_file below)
#   LOOMWATCH_BACKUP_DIR    where updates keep copies of the run history (default: ~/LoomWatch/backups)
#   LOOMWATCH_UPDATE_CHECK  off: never ask GitHub whether a newer version is out
#
# Developers who want the daemon against ./teams with their own flags can keep using scripts/dev.sh.
# Written for the bash 3.2 that ships with macOS: no associative arrays, no empty-array expansion.
set -euo pipefail

# Windows has its own launcher, loomwatch.cmd; this one needs lsof, ps and signals Git Bash lacks.
case "$(uname -s)" in
  MINGW* | MSYS* | CYGWIN*)
    printf '%s\n' "On Windows, start LoomWatch with loomwatch.cmd from PowerShell or Command Prompt (.\\loomwatch.cmd in this folder)." >&2
    exit 1
    ;;
esac

# Resolve symlinks so the script still finds its checkout when linked into a folder on PATH.
script=${BASH_SOURCE[0]}
while [ -L "$script" ]; do
  target=$(readlink "$script")
  case $target in
    /*) script=$target ;;
    *) script=$(dirname "$script")/$target ;;
  esac
done
repo_root=$(cd "$(dirname "$script")" && pwd -P)
cd "$repo_root"

# This script as the operator would type it again, for the instructions it prints: ./loomwatch in
# a copy of the source, ~/LoomWatch/app/loomwatch or loomwatch for a ready-built copy.
case $0 in
  */*)
    self=$0
    # Started through a folder on PATH, so typed as just its name.
    if [ "$(command -v "$(basename "$0")" 2>/dev/null)" = "$0" ]; then self=$(basename "$0"); fi
    ;;
  *) if [ -n "$(command -v "$0" 2>/dev/null)" ]; then self=$0; else self=./$0; fi ;;
esac
case $self in "$HOME"/*) self="~${self#"$HOME"}" ;; esac

if [ -t 1 ]; then bold=$(printf '\033[1m'); reset=$(printf '\033[0m'); else bold=; reset=; fi
say() { printf '%s\n' "$*"; }
step() { printf '\n%s==> %s%s\n' "$bold" "$*" "$reset"; }
failure_heading='LoomWatch could not start'
fail() {
  printf '\n%s%s:%s %s\n' "$bold" "$failure_heading" "$reset" "$*" >&2
  # An update asked for in the app also tells the LoomWatch started again after it why it stopped.
  if [ -n "${failure_note:-}" ]; then
    local why=$*
    printf '%s\n' "${why//The messages above say why./The window running LoomWatch says why.}" >"$failure_note" 2>/dev/null || true
  fi
  exit 1
}

# rustup and Homebrew install outside the PATH a fresh or non-interactive shell may have. Appended,
# so the operator's own ordering still wins.
for dir in "$HOME/.cargo/bin" /opt/homebrew/bin /usr/local/bin; do
  case ":$PATH:" in
    *":$dir:"*) ;;
    *) if [ -d "$dir" ]; then PATH="$PATH:$dir"; fi ;;
  esac
done
export PATH

command=start
open_browser=1
force_rebuild=0
back_up=1
assume_yes=0
for arg in "$@"; do
  case $arg in
    start | update | rollback | stop | import) command=$arg ;;
    version | --version) command=version ;;
    help | -h | --help) command=help ;;
    --no-open) open_browser=0 ;;
    --rebuild) force_rebuild=1 ;;
    --no-backup) back_up=0 ;;
    --yes | -y) assume_yes=1 ;;
    *)
      failure_heading=LoomWatch
      fail "unknown option '$arg'. Run $self help to see the options."
      ;;
  esac
done

teams_root=${LOOMWATCH_TEAMS_ROOT:-$HOME/LoomWatch/teams}
backup_root=${LOOMWATCH_BACKUP_DIR:-$HOME/LoomWatch/backups}
# A ready-built copy has its program in bin/ and no source code to build it from.
if [ -x bin/loomwatchd ] && [ ! -f Cargo.toml ]; then
  prebuilt=1
  binary=bin/loomwatchd
  state_dir=run
else
  prebuilt=0
  binary=target/release/loomwatchd
  state_dir=target
fi
build_stamp=target/release/.loomwatch-build
pid_file=$state_dir/loomwatchd.pid
# The script that stays beside a ready-built copy's LoomWatch, so `stop` can end both.
launcher_pid_file=$state_dir/launcher.pid

# The run history is one file. The ready-built copy in the usual folder keeps it where the program
# keeps it by default, in LoomWatch's state folder, so it outlives reinstalling the app. Every other
# copy, a copy of the source or a release being tried, keeps its own in its folder: two copies never
# share one, as they once shared a database by accident. The state folder and the Keychain items stay
# shared, so a copy of the source uses the key you gave LoomWatch. A release being tried sets
# LOOMWATCH_STATE_DIR and LOOMWATCH_KEY_STORE=file, which reach loomwatchd unchanged (docs/CI.md).
usual_app=
if [ -d "$HOME/LoomWatch/app" ]; then usual_app=$(cd "$HOME/LoomWatch/app" && pwd -P); fi
if [ -z "${LOOMWATCH_DATABASE:-}" ] && { [ "$prebuilt" = 0 ] || [ "$repo_root" != "$usual_app" ]; }; then
  LOOMWATCH_DATABASE="$repo_root/.loomwatch/loomwatch.db"
  export LOOMWATCH_DATABASE
fi

# Someone running a copy of the source is in its folder; someone running a ready-built copy may be
# anywhere, so instructions name that copy's files and folder in full.
# A path as the operator would type it, with ~ for the home folder: shorter, and a pasted log no
# longer shows the account name.
pretty_path() { case $1 in "$HOME"/*) printf '~%s\n' "${1#"$HOME"}" ;; *) printf '%s\n' "$1" ;; esac; }
folder_display=$(pretty_path "$repo_root")
where_is() { if [ "$prebuilt" = 1 ]; then printf '%s/%s\n' "$folder_display" "$1"; else printf '%s\n' "$1"; fi; }

# The last KEY=value line for KEY in .env, without surrounding quotes. .env is read, never
# sourced: sourcing would export the Compose-only host-runner settings into the native daemon.
env_value() {
  [ -f .env ] || return 0
  sed -n "s/^$1=//p" .env | tail -n 1 | tr -d '\r' | sed -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'$/\1/"
}

port=${LOOMWATCH_PORT:-$(env_value LOOMWATCH_PORT)}
port=${port:-3000}
url="http://127.0.0.1:$port"

is_macos() { [ "$(uname -s)" = Darwin ]; }

port_in_use() {
  command -v lsof >/dev/null 2>&1 && lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
}

loomwatch_is_running() {
  [ "$(curl -fsS --max-time 2 "$url/api/health" 2>/dev/null)" = ok ]
}

# The process listening on a port, and the folder it was started from. Empty when lsof is missing.
listener_pid() {
  command -v lsof >/dev/null 2>&1 && lsof -nP -t -iTCP:"$1" -sTCP:LISTEN 2>/dev/null | head -n 1
}
process_folder() {
  if [ -d "/proc/$1" ]; then
    readlink "/proc/$1/cwd" 2>/dev/null
  else
    lsof -a -p "$1" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -n 1
  fi
}

open_url() {
  [ "$open_browser" = 1 ] || return 0
  if is_macos; then
    open "$1"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$1" >/dev/null 2>&1 || true
  fi
}

# The file that holds the run history, as the program resolves it. Needs the program built.
database_file() { "./$binary" database-path; }

# A name for this copy of LoomWatch no other folder uses.
own_project_name() {
  local prefix=loomwatch
  if [ "$prebuilt" = 1 ]; then prefix=loomwatch-app; fi
  printf '%s-%08x\n' "$prefix" "$(printf '%s' "$repo_root" | cksum | cut -d ' ' -f 1)"
}

# A LoomWatch answering on the port is only this one when it was started from this folder. Another
# copy, among them one whose folder has since been deleted, holds the port with its own files.
already_running() {
  local pid folder where
  pid=$(listener_pid "$port" || true)
  folder=
  if [ -n "$pid" ]; then folder=$(process_folder "$pid" || true); fi
  if [ -n "$folder" ] && [ "$folder" != "$repo_root" ]; then
    where="from $folder"
    [ -d "$folder" ] || where="from $folder, a folder that no longer exists"
    fail "another copy of LoomWatch is already running at $url (process $pid, started $where). Stop it with: kill $pid
Then run $self again. To keep it running, start this copy on another port instead: LOOMWATCH_PORT=$((port + 1)) $self"
  fi
  say "LoomWatch is already running at $url"
  open_url "$url"
  exit 0
}

docker_app() {
  for app in /Applications/Docker.app "$HOME/Applications/Docker.app" /Applications/OrbStack.app; do
    if [ -d "$app" ]; then
      printf '%s\n' "$app"
      return 0
    fi
  done
  return 1
}

# Every missing tool in one list, so nobody fixes one, reruns, and only then meets the next.
check_prerequisites() {
  local missing='' brew=0
  if command -v brew >/dev/null 2>&1; then brew=1; fi

  # Only a copy of the source code is built here; a ready-built copy needs neither Node.js nor Rust.
  if [ "$prebuilt" = 0 ]; then
    if ! command -v node >/dev/null 2>&1; then
      if [ "$brew" = 1 ]; then
        missing="$missing
  - Node.js 22 or newer, which builds the browser app: brew install node (or https://nodejs.org/)"
      else
        missing="$missing
  - Node.js 22 or newer, which builds the browser app: https://nodejs.org/"
      fi
    elif ! node -e 'const [a, b] = process.versions.node.split(".").map(Number); process.exit(a > 22 || (a === 22 && b >= 12) ? 0 : 1)'; then
      missing="$missing
  - A newer Node.js: LoomWatch needs 22.12 or newer and this computer has $(node --version).
    Install the current version from https://nodejs.org/"
    fi

    if ! command -v cargo >/dev/null 2>&1; then
      missing="$missing
  - Rust, which builds the LoomWatch program. Install it with:
      curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y"
    fi
  fi

  if [ -n "$missing" ]; then
    printf '\n%sLoomWatch needs a few things installed first:%s\n%s\n\n' "$bold" "$reset" "$missing" >&2
    say "When they are installed, open a new terminal window and run $self again." >&2
    exit 1
  fi
}

ensure_teams_root() {
  [ -d "$teams_root" ] && return 0
  mkdir -p "$teams_root"
  cp examples/operator-stop.yaml "$teams_root/"
  say "Created your teams folder at $(pretty_path "$teams_root"), with an offline demo team in it."
}

# What the build depends on: the commit plus any local edits. An unchanged checkout never rebuilds.
source_fingerprint() {
  if command -v git >/dev/null 2>&1 && git rev-parse --git-dir >/dev/null 2>&1; then
    local paths='ui crates migrations schemas Cargo.toml Cargo.lock rust-toolchain.toml'
    # shellcheck disable=SC2086 # the path list is split on purpose
    {
      git rev-parse HEAD
      git status --porcelain -- $paths
      git diff HEAD -- $paths
    } | cksum
  else
    echo unversioned
  fi
}

build_if_needed() {
  [ "$prebuilt" = 0 ] || return 0
  local fingerprint
  fingerprint=$(source_fingerprint)
  if [ "$force_rebuild" = 0 ] && [ -x "$binary" ] && [ "$(cat "$build_stamp" 2>/dev/null)" = "$fingerprint" ]; then
    return 0
  fi
  step "Building LoomWatch (the first build takes a few minutes)"
  # The browser app is built first: it is packed into the LoomWatch program.
  (cd ui && npx --yes pnpm@12 install --frozen-lockfile && npx --yes pnpm@12 run build) ||
    fail "the browser app did not build. The messages above say why."
  cargo build --release --locked --bin loomwatchd ||
    fail "the LoomWatch program did not build. The messages above say why."
  printf '%s\n' "$fingerprint" >"$build_stamp"
}

# --- The run history an earlier version kept in Docker ------------------------------------------
# Earlier versions kept the run history in PostgreSQL, which this script ran in Docker. The first
# start after updating copies it into the file with `loomwatchd import-postgres`. The Docker
# database is only read: it is stopped again if it was stopped, and kept with everything in it, so
# going back to an earlier version with rollback finds it as it was.

# Whether this copy's settings name the database an earlier version set up.
has_earlier_database() {
  local password
  password=$(env_value POSTGRES_PASSWORD)
  [ -n "$password" ] && [ "$password" != replace-with-a-local-password ]
}

# The Docker Compose project that held the database: named in .env, or after the folder.
earlier_project() {
  local project=${COMPOSE_PROJECT_NAME:-$(env_value COMPOSE_PROJECT_NAME)}
  if [ -z "$project" ]; then
    project=$(basename "$repo_root" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9_-')
  fi
  printf '%s\n' "$project"
}

# The database's container, running or not.
earlier_container() {
  docker ps --all --quiet --filter "label=com.docker.compose.project=$(earlier_project)" \
    --filter label=com.docker.compose.service=postgres 2>/dev/null | head -n 1
}

# Compose found a database by its project name alone, so two folders with the same name shared one.
# Prints the other copy's folder when the database was created from one that is still there: its
# history is that copy's to bring over, not this one's.
other_database_owner() {
  local id=$1 owner
  owner=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' "$id" 2>/dev/null) || return 1
  [ -n "$owner" ] || return 1
  owner=$(cd "$owner" 2>/dev/null && pwd -P) || return 1
  [ "$owner" != "$repo_root" ] && [ -f "$owner/docker-compose.yml" ] || return 1
  printf '%s\n' "$owner"
}

# Docker is running, or was started and came up within a minute.
docker_is_up() {
  docker info >/dev/null 2>&1 && return 0
  local app waited=0
  if ! is_macos || ! app=$(docker_app); then return 1; fi
  say "Starting $(basename "$app" .app) to read the run history the earlier version kept there."
  open -a "$app" || return 1
  until docker info >/dev/null 2>&1; do
    [ "$waited" -ge 60 ] && return 1
    sleep 2
    waited=$((waited + 2))
  done
}

# The earlier history could not be read now. On the first start that is said once, plainly, and
# LoomWatch starts anyway; asked for with `import`, it is the answer. $2 is what to do first, such
# as "start Docker Desktop".
cannot_import_now() {
  if [ "$1" = asked ]; then fail "Docker is not available. To bring the history over, $2, then run $self import again."; fi
  say "Your run history from the earlier version is still in Docker. To bring it over, $2 and run: $self import"
}

# Copies a PostgreSQL archive into the file. $1 is its address, $2 how to name it.
run_import() {
  step "Bringing over your run history from $2"
  LOOMWATCH_IMPORT_FROM=$1 "./$binary" import-postgres
}

# $1 is auto (the first start after updating) or asked (`import`).
import_earlier_history() {
  local mode=$1 user password db container owner volume started='' port='' waited=0 imported=0
  if [ -n "${LOOMWATCH_DATABASE_URL:-}" ]; then
    run_import "$LOOMWATCH_DATABASE_URL" "your own PostgreSQL (LOOMWATCH_DATABASE_URL)" ||
      fail "the run history could not be brought over. The messages above say why. It is still in your PostgreSQL; try again with: $self import"
    return 0
  fi
  if ! has_earlier_database; then
    [ "$mode" = auto ] && return 0
    fail "this copy has no earlier run history in Docker: its settings file ($(where_is .env)) names no database."
  fi
  if ! command -v docker >/dev/null 2>&1; then
    cannot_import_now "$mode" "install Docker Desktop again"
    return 0
  fi
  if ! docker_is_up; then
    cannot_import_now "$mode" "start Docker Desktop"
    return 0
  fi
  user=$(env_value POSTGRES_USER)
  password=$(env_value POSTGRES_PASSWORD)
  db=$(env_value POSTGRES_DB)
  container=$(earlier_container)
  if [ -n "$container" ] && owner=$(other_database_owner "$container"); then
    [ "$mode" = auto ] && return 0
    fail "the Docker database named like this copy's belongs to the LoomWatch copy in $(pretty_path "$owner"). Run $self import there instead."
  fi
  if [ -z "$container" ]; then
    # Only the data is left (`docker compose down` keeps it): read it with a container of its own,
    # removed again afterwards. The data stays.
    volume="$(earlier_project)_postgres-data"
    if ! docker volume inspect "$volume" >/dev/null 2>&1; then
      [ "$mode" = auto ] && return 0
      fail "there is no earlier run history in Docker for this copy."
    fi
    container=$(docker run --detach --rm --volume "$volume:/var/lib/postgresql/data" \
      --publish 127.0.0.1::5432 postgres:17.6-bookworm) ||
      { cannot_import_now "$mode" "start Docker Desktop"; return 0; }
    started=temporary
  elif [ "$(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null)" != true ]; then
    docker start "$container" >/dev/null || { cannot_import_now "$mode" "start Docker Desktop"; return 0; }
    started=stopped
  fi
  until docker exec "$container" pg_isready -U "${user:-loomwatch}" -d "${db:-loomwatch}" >/dev/null 2>&1; do
    if [ "$waited" -ge 60 ]; then break; fi
    sleep 2
    waited=$((waited + 2))
  done
  port=$(docker port "$container" 5432/tcp 2>/dev/null | head -n 1 | sed 's/.*://')
  if [ -n "$port" ] &&
    run_import "postgres://${user:-loomwatch}:$password@127.0.0.1:$port/${db:-loomwatch}" "the earlier version's Docker database"; then
    imported=1
  fi
  # Stopped again when this started it. A ready-built copy's database is also stopped when an
  # update had started it: nothing reads it any more. A copy of the source may share its database
  # with a developer's own tools, so one found running stays running.
  if [ -n "$started" ] || { [ "$prebuilt" = 1 ] && [ "$imported" = 1 ]; }; then
    docker stop "$container" >/dev/null 2>&1 || true
  fi
  if [ "$imported" = 1 ]; then
    if [ "$prebuilt" = 1 ]; then
      say "The earlier database is kept in Docker as it was, so $self rollback can still go back to the earlier version."
    else
      say "The earlier database is kept in Docker as it was."
    fi
    return 0
  fi
  if [ "$mode" = asked ]; then
    fail "the run history could not be brought over. The messages above say why. It is still in Docker; try again with: $self import"
  fi
  say "Your run history could not be brought over this time; it is still in Docker. Try again with: $self import"
}

start() {
  if loomwatch_is_running; then already_running; fi
  if port_in_use "$port"; then
    fail "another program is using port $port. Start LoomWatch on a different port with: LOOMWATCH_PORT=$((port + 1)) $self"
  fi

  check_prerequisites
  ensure_teams_root
  build_if_needed

  local database
  database=$(database_file) || fail "LoomWatch could not say where it keeps the run history. The messages above say why."
  # The first start after updating from a version that kept the history in Docker.
  if [ ! -e "$database" ]; then import_earlier_history auto; fi

  # The update hand-over is supervise's to set: a daemon told about one that nothing is running
  # would stop and stay stopped.
  unset LOOMWATCH_SUPERVISED LOOMWATCH_UPDATE_REQUEST LOOMWATCH_UPDATE_FAILED LOOMWATCH_IMPORT_FROM
  # Which checkout is running, for the "Send feedback" report. `-dirty` marks local edits. A
  # ready-built copy names the commit its release was built from, in VERSION.
  if [ "$prebuilt" = 1 ]; then
    LOOMWATCH_COMMIT=$(cut -d ' ' -f 2 VERSION 2>/dev/null || true)
  else
    LOOMWATCH_COMMIT=$(git describe --always --dirty --abbrev=7 2>/dev/null || true)
  fi
  export LOOMWATCH_COMMIT
  # How this copy is updated, for the app's notice that a newer version is out (ADR 0052).
  LOOMWATCH_INSTALL=source
  if [ "$prebuilt" = 1 ]; then LOOMWATCH_INSTALL=release; fi
  # Typed as ./loomwatch only works from this folder, so the command says to go there first.
  LOOMWATCH_UPDATE_COMMAND="$self update"
  case $self in ./*) LOOMWATCH_UPDATE_COMMAND="cd $folder_display && $self update" ;; esac
  export LOOMWATCH_INSTALL LOOMWATCH_UPDATE_COMMAND

  # Open the browser once the server answers. This runs beside the daemon, which runs in the
  # foreground below, or replaces this script, so Ctrl-C reaches it exactly as if it had been
  # started by hand.
  (
    for _ in $(seq 1 120); do
      if loomwatch_is_running; then
        open_url "$url"
        exit 0
      fi
      sleep 0.5
    done
  ) &

  step "LoomWatch is starting at $url"
  say "Your teams are in $(pretty_path "$teams_root")"
  say "Your run history is in $(pretty_path "$database")"
  say "Keep this window open while you use LoomWatch. Press Ctrl-C to stop it."
  mkdir -p "$state_dir"
  if [ "$prebuilt" = 1 ]; then supervise; fi
  echo "$$" >"$pid_file"
  exec "./$binary" serve --teams-root "$teams_root" --listen "127.0.0.1:$port"
}

# Sends a signal to LoomWatch's whole process group when it has one ($3), as Ctrl-C would, so
# running agents stop with it, then waits up to ten seconds. True when it has stopped.
signal_and_wait() {
  local signal=$1 pid=$2 group=$3
  if [ -n "$group" ]; then kill "-$signal" -- "-$group" 2>/dev/null || true; else kill "-$signal" "$pid" 2>/dev/null || true; fi
  for _ in $(seq 1 20); do
    kill -0 "$pid" 2>/dev/null || return 0
    sleep 0.5
  done
  ! kill -0 "$pid" 2>/dev/null
}

stop() {
  failure_heading='LoomWatch could not stop'
  local pid pgid group stopped=0
  pid=$(cat "$pid_file" 2>/dev/null || true)
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    case $(ps -p "$pid" -o comm= 2>/dev/null) in
      *loomwatchd*)
        pgid=$(ps -p "$pid" -o pgid= | tr -d ' ')
        # Started from a terminal, LoomWatch leads its process group, or the script staying beside
        # it does: the group is LoomWatch, the agents it runs, and that script.
        group=
        if [ "$pgid" = "$pid" ] || [ "$pgid" = "$(cat "$launcher_pid_file" 2>/dev/null || true)" ]; then group=$pgid; fi
        # One started in the background ignores Ctrl-C's signal, so it is then asked to end.
        if ! signal_and_wait INT "$pid" "$group" && ! signal_and_wait TERM "$pid" "$group"; then
          fail "LoomWatch (process $pid) is still running. Stop it with: kill -9 $pid"
        fi
        stopped=1
        say "Stopped LoomWatch. Your teams and history are kept."
        ;;
    esac
  fi
  rm -f "$pid_file" "$launcher_pid_file"
  if [ "$stopped" = 0 ] && loomwatch_is_running; then
    local other
    other=$(listener_pid "$port" || true)
    if [ -n "$other" ]; then
      say "LoomWatch at $url was not started by $self in this folder. It is process $other, from $(process_folder "$other" || true). Press Ctrl-C in the window running it, or run: kill $other"
    else
      say "LoomWatch at $url was not started by $self. Press Ctrl-C in the window running it."
    fi
  fi
}

# `import`: the earlier history, brought over by hand. LoomWatch must be stopped: the import
# writes the whole history in one go, and LoomWatch would wait on it.
import_by_hand() {
  failure_heading='LoomWatch could not bring over the earlier run history'
  if loomwatch_is_running; then
    fail "LoomWatch is running. Stop it first (press Ctrl-C in its window, or run $self stop), then run $self import."
  fi
  build_if_needed
  [ -x "$binary" ] || fail "the LoomWatch program is missing from $(where_is "$binary"). Run $self first."
  import_earlier_history asked
}

# --- Updating (ADR 0052) -------------------------------------------------------------------------
# An update never starts by itself: the app only says a newer version is out. `update` saves a copy
# of the run history before anything can change it, and in a ready-built copy keeps the version it
# replaces in .previous, so `rollback` can put it back.

# The version this copy runs: VERSION's first word in a ready-built copy, the program's own in a
# copy of the source.
installed_version() {
  if [ "$prebuilt" = 1 ]; then
    cut -d ' ' -f 1 VERSION 2>/dev/null || true
  else
    sed -n 's/^version = "\(.*\)"$/\1/p' crates/loomwatch-backend/Cargo.toml 2>/dev/null | head -n 1
  fi
}

is_version_core() {
  case $1 in '' | *[!0-9.]* | .* | *. | *..*) return 1 ;; esac
  [ "$(printf '%s' "$1" | tr -cd . | wc -c | tr -d ' ')" = 2 ]
}

# True when version $1 is newer than $2. Compares MAJOR.MINOR.PATCH, ignoring a leading v and any
# -pre-release or +build part. Anything that is not a version is never newer.
newer_than() {
  local a=${1#v} b=${2#v} a1 a2 a3 b1 b2 b3
  a=${a%%[-+]*}
  b=${b%%[-+]*}
  is_version_core "$a" && is_version_core "$b" || return 1
  IFS=. read -r a1 a2 a3 <<EOF
$a
EOF
  IFS=. read -r b1 b2 b3 <<EOF
$b
EOF
  if [ "$a1" -ne "$b1" ]; then [ "$a1" -gt "$b1" ]; return; fi
  if [ "$a2" -ne "$b2" ]; then [ "$a2" -gt "$b2" ]; return; fi
  [ "$a3" -gt "$b3" ]
}

update_check_off() {
  case $(printf '%s' "${LOOMWATCH_UPDATE_CHECK:-}" | tr '[:upper:]' '[:lower:]') in
    0 | off | false | no) return 0 ;;
    *) return 1 ;;
  esac
}

# The newest published release, such as v0.1.6. Fails when GitHub cannot be asked, and for a trial
# of files served from elsewhere (LOOMWATCH_DOWNLOAD_BASE), which say nothing about GitHub.
latest_release() {
  [ -z "${LOOMWATCH_DOWNLOAD_BASE:-}" ] || return 1
  local installer=scripts/install.sh
  if [ "$prebuilt" = 1 ]; then installer=./install.sh; fi
  bash "$installer" --latest 2>/dev/null
}

# Asks a yes-or-no question. No is the answer when there is no one at a terminal to ask, unless
# --yes answered for them.
confirm() {
  if [ "$assume_yes" = 1 ]; then return 0; fi
  [ -t 0 ] || return 1
  local answer
  printf '%s [y/N] ' "$1"
  read -r answer || return 1
  case $answer in [yY] | [yY][eE][sS]) return 0 ;; *) return 1 ;; esac
}

# The layout LoomWatch set the run history up in: the newest table change applied. Empty when
# there is no run history yet, such as before LoomWatch first started.
database_layout() {
  [ -x "$binary" ] || return 0
  "./$binary" database-layout 2>/dev/null | tr -d '[:space:]' || true
}

# One folder of copies per copy of LoomWatch, named as its Docker database once was, so copies
# saved before and after LoomWatch kept its history in a file sit together.
backup_folder() {
  local name=${COMPOSE_PROJECT_NAME:-$(env_value COMPOSE_PROJECT_NAME)}
  if [ -z "$name" ]; then
    if [ "$prebuilt" = 0 ]; then
      name=$(basename "$repo_root" | tr '[:upper:]' '[:lower:]')
    elif [ "$repo_root" = "$usual_app" ]; then
      name=loomwatch-app
    else
      name=$(own_project_name)
    fi
  fi
  printf '%s/%s\n' "$backup_root" "$name"
}

# Saves the run history in one file that only this account can read, a consistent copy made by
# the program itself even while LoomWatch runs, and keeps the newest three copies. Sets
# backup_file. $1 is added to the file's name.
save_database() {
  local folder
  folder=$(backup_folder)
  mkdir -p "$folder"
  chmod 700 "$backup_root" "$folder" 2>/dev/null || true
  # Named from the time first, so sorting the names sorts the copies oldest first.
  backup_file="$folder/loomwatch-$(date -u +%Y%m%dT%H%M%SZ)-$(installed_version)$1.db"
  rm -f "$backup_file.partial"
  if ! (umask 077 && "./$binary" backup "$backup_file.partial" >/dev/null) || [ ! -s "$backup_file.partial" ]; then
    rm -f "$backup_file.partial"
    return 1
  fi
  mv "$backup_file.partial" "$backup_file"
  local copies
  copies=$(find "$folder" -maxdepth 1 -name 'loomwatch-*.db' | sort)
  if [ "$(printf '%s\n' "$copies" | wc -l | tr -d ' ')" -gt 3 ]; then
    printf '%s\n' "$copies" | sed -n "1,$(($(printf '%s\n' "$copies" | wc -l) - 3))p" |
      while IFS= read -r old; do rm -f "$old"; done
  fi
}

# Before an update can change the run history: notes its layout, so rollback can tell whether the
# earlier version can still read it, and saves a copy. Sets layout_before and backup_file, each
# empty when there was nothing to note or save.
back_up_before_update() {
  layout_before=
  backup_file=
  layout_before=$(database_layout)
  # Never started here: there is no run history yet, so nothing to keep.
  [ -n "$layout_before" ] || return 0
  if [ "$back_up" = 0 ]; then
    say "Not saving a copy of your run history (--no-backup)."
    return 0
  fi
  step "Saving a copy of your run history"
  save_database '' ||
    fail "the copy of your run history could not be saved, so LoomWatch was not changed. The messages above say why. To update without a copy, run: $self update --no-backup"
  say "Saved in $(pretty_path "$backup_file"). The three newest copies are kept."
}

# `update` while LoomWatch runs from this folder: stop it first, if the operator agrees.
stop_before_update() {
  local pid folder=
  pid=$(listener_pid "$port" || true)
  if [ -n "$pid" ]; then folder=$(process_folder "$pid" || true); fi
  if [ -n "$folder" ] && [ "$folder" != "$repo_root" ]; then
    fail "another copy of LoomWatch is running at $url (process $pid, from $folder). Stop it first, then run $self update."
  fi
  if ! confirm "LoomWatch is running. Updating stops it, and any team still working stops too. Stop it and update now?"; then
    fail "it is still running. Stop it first (press Ctrl-C in its window, or run $self stop), then run $self update."
  fi
  stop
  failure_heading='LoomWatch could not update'
  if loomwatch_is_running; then
    fail "it is still running. Stop it first (press Ctrl-C in its window), then run $self update."
  fi
}

# What rollback needs, beside the version the installer kept: which version that is, the layout
# of the run history it ran on, and the copy of the run history saved before the update.
remember_for_rollback() {
  [ -d .previous ] || return 0
  {
    printf 'version=%s\n' "$1"
    printf 'layout=%s\n' "$layout_before"
    printf 'backup=%s\n' "$backup_file"
  } >.previous/ROLLBACK
}

rollback_value() { sed -n "s/^$1=//p" .previous/ROLLBACK 2>/dev/null | tail -n 1; }

# This script, started again from the files now in this folder.
start_again() {
  if [ "$open_browser" = 0 ]; then exec "$repo_root/loomwatch" start --no-open; fi
  exec "$repo_root/loomwatch" start
}

# Installs a release in this ready-built copy: saves the run history, has the installer replace
# the files, keeping this version in .previous, and notes what rollback needs. $1 is the
# version installed now. Fails, changing nothing, when any step does.
install_release() {
  back_up_before_update
  # The installer that put this copy here fetches the release and replaces it in place, keeping
  # the version it replaces in .previous. This script keeps running from the copy it started as.
  bash ./install.sh --update --dir "$repo_root" ||
    fail "the download did not finish, and LoomWatch $1 was left as it was. The messages above say why."
  remember_for_rollback "$1"
}

update() {
  failure_heading='LoomWatch could not update'
  if loomwatch_is_running; then stop_before_update; fi
  local installed latest
  installed=$(installed_version)
  if [ "$prebuilt" = 1 ]; then
    # A release asked for by name is installed even when it is older: that is how to go back
    # further than rollback does.
    if [ -z "${LOOMWATCH_VERSION:-}" ] && latest=$(latest_release) && ! newer_than "$latest" "$installed"; then
      say "LoomWatch $installed is the newest version."
      start_again
    fi
    install_release "$installed"
    if [ -d .previous ]; then say "If the new version gives you trouble, $self rollback goes back to $installed."; fi
    start_again
  fi
  command -v git >/dev/null 2>&1 || fail "updating needs Git. Install it with: xcode-select --install"
  step "Downloading the latest LoomWatch"
  local before
  before=$(git rev-parse HEAD)
  git pull --ff-only ||
    fail "the download did not finish. If Git says your local changes would be overwritten, ask whoever changed files in this folder before discarding them."
  # The new code changes the run history's layout when it starts, after it is built; the program
  # still here is the one built from the code before the pull.
  if [ "$(git rev-parse HEAD)" != "$before" ]; then
    back_up_before_update
    say "To go back to the code you had: git checkout $(git rev-parse --short "$before")"
  fi
  failure_heading='LoomWatch could not start'
  start
}

# --- Updating from the app (ADR 0052, amended) -----------------------------------------------------
# A ready-built copy's LoomWatch runs beside this script instead of in its place, so Update and
# restart in the app can hand the update to it. LoomWatch names the release in update_request and
# exits with update_exit_code; this script then installs that release as `update` does and starts
# LoomWatch again in this window. When the update does not finish, it starts the version that was
# running again, and tells it why.

# The exit status LoomWatch asks for an update with (EX_TEMPFAIL). Any other one ends this script.
update_exit_code=75
update_request="$repo_root/$state_dir/update-request"
update_failed="$repo_root/$state_dir/update-failed"

supervise() {
  local code
  export LOOMWATCH_SUPERVISED=1 LOOMWATCH_UPDATE_REQUEST="$update_request"
  echo "$$" >"$launcher_pid_file"
  while :; do
    rm -f "$update_request"
    code=0
    # In the foreground, so Ctrl-C reaches LoomWatch and the agents it runs as it always has. sh
    # writes down its own process number, which exec hands on to LoomWatch, for stop to find.
    sh -c 'echo "$$" >"$1" && shift && exec "$@"' sh "$pid_file" \
      "./$binary" serve --teams-root "$teams_root" --listen "127.0.0.1:$port" || code=$?
    unset LOOMWATCH_UPDATE_FAILED
    if [ "$code" != "$update_exit_code" ]; then
      rm -f "$launcher_pid_file"
      exit "$code"
    fi
    update_from_app
  done
}

# After LoomWatch stopped for Update and restart. Starts the new version in its place, or returns
# with LOOMWATCH_UPDATE_FAILED set, for the version still here to be started again.
update_from_app() {
  local installed tag
  installed=$(installed_version)
  tag=$(sed -n 1p "$update_request" 2>/dev/null | tr -d '\r' || true)
  rm -f "$update_request"
  # In a subshell, so a step that fails ends only the update, not this window's LoomWatch.
  rm -f "$update_failed"
  (
    failure_heading='LoomWatch could not update'
    failure_note=$update_failed
    install_from_app "$installed" "$tag"
  ) || true
  # Whatever the steps said, the files in place decide which version runs next.
  if [ "$(installed_version)" != "$installed" ]; then
    if [ -d .previous ]; then say "If the new version gives you trouble, $self rollback goes back to $installed."; fi
    unset LOOMWATCH_SUPERVISED LOOMWATCH_UPDATE_REQUEST
    rm -f "$launcher_pid_file"
    # The app's tab is still open, and it waits for the new version: no second tab.
    exec "$repo_root/loomwatch" start --no-open
  fi
  LOOMWATCH_UPDATE_FAILED=$(cat "$update_failed" 2>/dev/null || true)
  rm -f "$update_failed"
  export LOOMWATCH_UPDATE_FAILED="${LOOMWATCH_UPDATE_FAILED:-the update stopped before it finished. The window running LoomWatch says why.}"
  step "Starting LoomWatch $installed again"
}

# The release the app named, installed. Fails, changing nothing, unless it is a version number
# newer than this one.
install_from_app() {
  local installed=$1 tag=$2
  case $tag in
    v[0-9]*.[0-9]*.[0-9]*) ;;
    *) fail "LoomWatch did not say which version to install." ;;
  esac
  case $tag in *[!0-9A-Za-z.+-]*) fail "LoomWatch asked for a version that is not a version number." ;; esac
  newer_than "$tag" "$installed" || fail "${tag#v} is not newer than LoomWatch $installed, so nothing was changed."
  step "Updating LoomWatch $installed to ${tag#v}, as asked in the app"
  LOOMWATCH_VERSION=$tag install_release "$installed"
}

# Puts a saved copy in place of the run history file: copied beside it first, then renamed over
# it, so the file in use is replaced only once the copy is whole.
restore_database() {
  local backup=$1 database
  database=$(database_file) || fail "LoomWatch could not say where it keeps the run history, so nothing was changed."
  rm -f "$database.restoring"
  if ! (umask 077 && cp "$backup" "$database.restoring"); then
    rm -f "$database.restoring"
    fail "the copy in $(pretty_path "$backup") could not be restored, so nothing was changed. The messages above say why."
  fi
  # The write-ahead log belongs to the file being replaced, and would be read into the copy. What
  # it held is in the copy saved just before this.
  rm -f "$database-wal" "$database-shm"
  mv "$database.restoring" "$database" ||
    fail "the copy could not be put in place. It is in $(pretty_path "$database.restoring"); the copy saved before going back is in $(pretty_path "$backup_file")."
}

# An update may have changed how the run history is stored, which the earlier version cannot read.
# Then the run history goes back to the copy saved before the update, after what was recorded
# since is saved to a copy of its own.
restore_database_if_needed() {
  local current=$1 previous=$2 layout_then layout_now backup
  layout_then=$(rollback_value layout)
  backup=$(rollback_value backup)
  [ -n "$layout_then" ] || return 0
  layout_now=$(database_layout)
  if [ -z "$layout_now" ] || [ "$layout_now" = "$layout_then" ]; then return 0; fi
  if [ -z "$backup" ] || [ ! -f "$backup" ]; then
    fail "LoomWatch $current changed how your run history is stored, and $previous cannot read it. The copy saved before the update ${backup:+($(pretty_path "$backup")) }is gone, so nothing was changed. Keep using $current by running: $self"
  fi
  say "LoomWatch $current changed how your run history is stored, and $previous cannot read it. Going back also puts the run history back to the copy saved before the update, $(pretty_path "$backup"). What was recorded since is saved to another copy first; $previous will not show it."
  confirm "Go back to $previous, with the run history from before the update?" || fail "nothing was changed."
  step "Putting the run history back"
  save_database -before-rollback ||
    fail "the run history recorded since the update could not be saved, so nothing was changed. The messages above say why."
  say "Saved the run history recorded since the update in $(pretty_path "$backup_file")."
  restore_database "$backup"
}

# Whether the kept version is one that keeps its run history in PostgreSQL in Docker: its launcher
# has the function that said so. (The bracket keeps this line from matching itself.)
previous_uses_docker() { grep -q '^uses_docker_databas[e]() {' .previous/loomwatch 2>/dev/null; }

# Moves the kept version's files over the current ones. Each is a rename in this folder; the
# current version's files wait in a scratch folder until every one is in place.
put_previous_back() {
  local scratch item name
  scratch=$(mktemp -d "$repo_root/.loomwatch-rollback.XXXXXX")
  for item in .previous/* .previous/.[!.]*; do
    [ -e "$item" ] || continue
    name=$(basename "$item")
    [ "$name" != ROLLBACK ] || continue
    if [ -e "$name" ] && ! mv "$name" "$scratch/$name"; then
      fail "could not move $name aside. The files of both versions are in $folder_display and $(pretty_path "$scratch")."
    fi
    mv "$item" "$name" ||
      fail "could not put $name back. The files of both versions are in $folder_display and $(pretty_path "$scratch")."
  done
  rm -rf .previous "$scratch"
}

rollback() {
  failure_heading='LoomWatch could not go back'
  if [ "$prebuilt" = 0 ]; then
    fail "rollback is for a ready-built copy. In a copy of the source code, Git keeps every version: find the one you want with git log, git checkout it, then run $self"
  fi
  if [ ! -x .previous/bin/loomwatchd ] || [ ! -f .previous/loomwatch ]; then
    fail "no earlier version is kept in $folder_display. Each update keeps the version it replaced, until the next update. To install a particular release instead, run: LOOMWATCH_VERSION=v0.1.4 $self update (the versions are listed at https://github.com/tnghia903/loomwatch/releases)"
  fi
  if loomwatch_is_running; then
    fail "it is still running. Stop it first (press Ctrl-C in its window, or run $self stop), then run $self rollback."
  fi
  local current previous
  current=$(installed_version)
  previous=$(cut -d ' ' -f 1 .previous/VERSION 2>/dev/null || true)
  previous=${previous:-the earlier version}
  step "Going back from LoomWatch $current to $previous"
  if previous_uses_docker; then
    # Its run history is in Docker, where the update only read it: it is all still there.
    say "LoomWatch $previous keeps its run history in Docker, as it was before the update. What you ran since then stays in $(pretty_path "$(database_file)"), which $previous does not read. After you update again, $self import brings over what $previous records in the meantime."
  else
    restore_database_if_needed "$current" "$previous"
  fi
  put_previous_back
  say "LoomWatch is back to $previous. Run $self update when you want the newest version again."
  start_again
}

show_version() {
  local installed commit latest
  installed=$(installed_version)
  if [ "$prebuilt" = 1 ]; then
    commit=$(cut -d ' ' -f 2 VERSION 2>/dev/null || true)
  else
    commit=$(git describe --always --dirty --abbrev=7 2>/dev/null || true)
  fi
  say "LoomWatch ${installed:-(version unknown)}${commit:+ ($commit)}"
  if update_check_off; then
    say "Checking for new versions is off (LOOMWATCH_UPDATE_CHECK)."
  elif latest=$(latest_release); then
    if newer_than "$latest" "$installed"; then
      say "LoomWatch ${latest#v} is out. Update with: $self update"
    elif newer_than "$installed" "$latest"; then
      say "This is newer than the newest release, ${latest#v}."
    else
      say "This is the newest release."
    fi
  else
    say "Could not ask GitHub for the newest release."
  fi
  if [ "$prebuilt" = 1 ] && [ -f .previous/VERSION ]; then
    say "The version it replaced, $(cut -d ' ' -f 1 .previous/VERSION), is kept: $self rollback goes back to it."
  fi
}

usage() {
  local start_does='Set up anything missing, build if needed, start LoomWatch and open it (the default)'
  local update_does='Save a copy of the run history, download the latest LoomWatch, rebuild it and start it'
  local rollback_line='' rebuild_option='
  --rebuild     Build again even if nothing changed'
  if [ "$prebuilt" = 1 ]; then
    start_does='Set up anything missing, start LoomWatch and open it (the default)'
    update_does='Save a copy of the run history, install the newest release, then start it'
    rollback_line='
  rollback  Go back to the version the last update replaced'
    rebuild_option=
  fi
  cat <<EOF
Usage: $self [command] [options]

Commands:
  start     $start_does
  update    $update_does$rollback_line
  version   Say which version this is, and whether a newer one is out
  import    Bring over the run history an earlier version kept in Docker
  stop      Stop LoomWatch. Your teams and history are kept.
  help      Show this help

Options:
  --no-open     Do not open the browser
  --no-backup   Update without saving a copy of the run history first
  --yes         Answer yes to questions, such as stopping LoomWatch to update it$rebuild_option

Settings (environment variables):
  LOOMWATCH_TEAMS_ROOT     Where your teams live (now: $(pretty_path "$teams_root"))
  LOOMWATCH_PORT           Browser port (now: $port)
  LOOMWATCH_DATABASE       The file that holds the run history
  LOOMWATCH_BACKUP_DIR     Where updates save copies of the run history (now: $(pretty_path "$backup_root"))
  LOOMWATCH_UPDATE_CHECK   off: never ask GitHub whether a newer version is out
EOF
}

case $command in
  start) start ;;
  update) update ;;
  rollback) rollback ;;
  version) show_version ;;
  import) import_by_hand ;;
  stop) stop ;;
  help) usage ;;
esac
