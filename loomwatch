#!/usr/bin/env bash
# One command to set up, build, start, update and stop LoomWatch on this computer.
#
#   ./loomwatch            set up anything missing, build if the code changed, start, open the browser
#   ./loomwatch update     download the latest version, rebuild, and start
#   ./loomwatch stop       stop LoomWatch and its database (your teams and history are kept)
#
# The same script runs a copy of the source code, which it builds, and a ready-built copy put in
# ~/LoomWatch/app by scripts/install.sh, which carries its program in bin/ and updates from the
# newest release instead of from Git.
#
# Optional settings, read from the environment:
#   LOOMWATCH_TEAMS_ROOT    where your teams live (default: ~/LoomWatch/teams)
#   LOOMWATCH_PORT          browser port (default: LOOMWATCH_PORT in .env, else 3000)
#   LOOMWATCH_DATABASE_URL  use your own PostgreSQL instead of the one this script runs in Docker
#
# Developers who want the daemon against ./teams with their own flags can keep using scripts/dev.sh.
# Written for the bash 3.2 that ships with macOS: no associative arrays, no empty-array expansion.
set -euo pipefail

# Resolve symlinks so the script still finds its checkout when linked into a folder on PATH.
script=${BASH_SOURCE[0]}
while [ -L "$script" ]; do
  target=$(readlink "$script")
  case $target in
    /*) script=$target ;;
    *) script=$(dirname "$script")/$target ;;
  esac
done
repo_root=$(cd "$(dirname "$script")" && pwd -P)
cd "$repo_root"

# This script as the operator would type it again, for the instructions it prints: ./loomwatch in
# a copy of the source, ~/LoomWatch/app/loomwatch or loomwatch for a ready-built copy.
case $0 in
  */*)
    self=$0
    # Started through a folder on PATH, so typed as just its name.
    if [ "$(command -v "$(basename "$0")" 2>/dev/null)" = "$0" ]; then self=$(basename "$0"); fi
    ;;
  *) if [ -n "$(command -v "$0" 2>/dev/null)" ]; then self=$0; else self=./$0; fi ;;
esac
case $self in "$HOME"/*) self="~${self#"$HOME"}" ;; esac

if [ -t 1 ]; then bold=$(printf '\033[1m'); reset=$(printf '\033[0m'); else bold=; reset=; fi
say() { printf '%s\n' "$*"; }
step() { printf '\n%s==> %s%s\n' "$bold" "$*" "$reset"; }
failure_heading='LoomWatch could not start'
fail() { printf '\n%s%s:%s %s\n' "$bold" "$failure_heading" "$reset" "$*" >&2; exit 1; }

# rustup and Homebrew install outside the PATH a fresh or non-interactive shell may have. Appended,
# so the operator's own ordering still wins.
for dir in "$HOME/.cargo/bin" /opt/homebrew/bin /usr/local/bin; do
  case ":$PATH:" in
    *":$dir:"*) ;;
    *) if [ -d "$dir" ]; then PATH="$PATH:$dir"; fi ;;
  esac
done
export PATH

command=start
open_browser=1
force_rebuild=0
for arg in "$@"; do
  case $arg in
    start | update | stop) command=$arg ;;
    help | -h | --help) command=help ;;
    --no-open) open_browser=0 ;;
    --rebuild) force_rebuild=1 ;;
    *)
      failure_heading=LoomWatch
      fail "unknown option '$arg'. Run $self help to see the options."
      ;;
  esac
done

teams_root=${LOOMWATCH_TEAMS_ROOT:-$HOME/LoomWatch/teams}
# A ready-built copy has its program in bin/ and no source code to build it from.
if [ -x bin/loomwatchd ] && [ ! -f Cargo.toml ]; then
  prebuilt=1
  binary=bin/loomwatchd
  state_dir=run
else
  prebuilt=0
  binary=target/release/loomwatchd
  state_dir=target
fi
build_stamp=target/release/.loomwatch-build
pid_file=$state_dir/loomwatchd.pid

# Someone running a copy of the source is in its folder; someone running a ready-built copy may be
# anywhere, so instructions name that copy's files and folder in full.
case $repo_root in "$HOME"/*) folder_display="~${repo_root#"$HOME"}" ;; *) folder_display=$repo_root ;; esac
where_is() { if [ "$prebuilt" = 1 ]; then printf '%s/%s\n' "$folder_display" "$1"; else printf '%s\n' "$1"; fi; }
in_this_folder() { if [ "$prebuilt" = 1 ]; then printf 'cd %s && ' "$folder_display"; fi; }

# The last KEY=value line for KEY in .env, without surrounding quotes. .env is read, never
# sourced: sourcing would export the Compose-only host-runner settings into the native daemon.
env_value() {
  [ -f .env ] || return 0
  sed -n "s/^$1=//p" .env | tail -n 1 | tr -d '\r' | sed -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'$/\1/"
}

port=${LOOMWATCH_PORT:-$(env_value LOOMWATCH_PORT)}
port=${port:-3000}
url="http://127.0.0.1:$port"

is_macos() { [ "$(uname -s)" = Darwin ]; }

port_in_use() {
  command -v lsof >/dev/null 2>&1 && lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
}

loomwatch_is_running() {
  [ "$(curl -fsS --max-time 2 "$url/api/health" 2>/dev/null)" = ok ]
}

# The process listening on a port, and the folder it was started from. Empty when lsof is missing.
listener_pid() {
  command -v lsof >/dev/null 2>&1 && lsof -nP -t -iTCP:"$1" -sTCP:LISTEN 2>/dev/null | head -n 1
}
process_folder() {
  if [ -d "/proc/$1" ]; then
    readlink "/proc/$1/cwd" 2>/dev/null
  else
    lsof -a -p "$1" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -n 1
  fi
}

open_url() {
  [ "$open_browser" = 1 ] || return 0
  if is_macos; then
    open "$1"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$1" >/dev/null 2>&1 || true
  fi
}

uses_docker_database() { [ -z "${LOOMWATCH_DATABASE_URL:-}" ]; }

database_is_running() {
  docker info >/dev/null 2>&1 && [ -n "$(docker compose ps --status running --quiet postgres 2>/dev/null)" ]
}

# Whether the database still holds what LoomWatch set up when it started, not a new, empty one.
database_has_loomwatch_tables() {
  local found
  found=$(printf '%s\n' "select to_regclass('public._sqlx_migrations') is not null;" |
    docker compose exec -T postgres sh -c 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -tA' 2>/dev/null) || true
  [ "$found" = t ]
}

# A LoomWatch answering on the port is only this one when it was started from this folder, and it
# only works while its database runs. Another copy, among them one whose folder has since been
# deleted, holds the port without this copy's database, so stopping here would never create it.
already_running() {
  local pid folder where
  pid=$(listener_pid "$port" || true)
  folder=
  if [ -n "$pid" ]; then folder=$(process_folder "$pid" || true); fi
  if [ -n "$folder" ] && [ "$folder" != "$repo_root" ]; then
    where="from $folder"
    [ -d "$folder" ] || where="from $folder, a folder that no longer exists"
    fail "another copy of LoomWatch is already running at $url (process $pid, started $where). Stop it with: kill $pid
Then run $self again. To keep it running, start this copy on another port instead: LOOMWATCH_PORT=$((port + 1)) $self"
  fi
  if uses_docker_database && ! database_is_running; then
    # This copy outlived its database: the container was stopped or removed, or Docker Desktop was
    # quit. Its restart policy covers only Docker restarting, so it is started again here, and
    # LoomWatch reconnects on its next query, as long as the database still holds its tables.
    say "LoomWatch is running at $url, but its database had stopped. Starting the database again."
    wake_docker
    start_database
    if ! database_has_loomwatch_tables; then
      local stop_with="$self stop"
      if [ -n "$pid" ]; then stop_with="kill $pid"; fi
      fail "the database LoomWatch was using is gone, and LoomWatch only sets up a new one when it starts. Stop it with: $stop_with
Then run $self again."
    fi
  fi
  say "LoomWatch is already running at $url"
  open_url "$url"
  exit 0
}

docker_app() {
  for app in /Applications/Docker.app "$HOME/Applications/Docker.app" /Applications/OrbStack.app; do
    if [ -d "$app" ]; then
      printf '%s\n' "$app"
      return 0
    fi
  done
  return 1
}

# Every missing tool in one list, so nobody fixes one, reruns, and only then meets the next.
check_prerequisites() {
  local missing='' brew=0
  if command -v brew >/dev/null 2>&1; then brew=1; fi

  if uses_docker_database; then
    local app
    if ! command -v docker >/dev/null 2>&1 && is_macos && app=$(docker_app); then
      # Docker Desktop installs its `docker` command the first time it is opened.
      open -a "$app"
      missing="$missing
  - Docker Desktop is installed but has not been set up yet. It is opening now: finish its
    first-start steps, wait until it says it is running, then run $self again."
    elif ! command -v docker >/dev/null 2>&1 || ! docker compose version >/dev/null 2>&1; then
      if [ "$brew" = 1 ]; then
        missing="$missing
  - Docker Desktop, which runs the database: brew install --cask docker-desktop
    (or download it from https://docs.docker.com/desktop/), then open it once."
      else
        missing="$missing
  - Docker Desktop, which runs the database: https://docs.docker.com/desktop/
    Open it once after installing."
      fi
    fi
  fi

  # Only a copy of the source code is built here; a ready-built copy needs neither Node.js nor Rust.
  if [ "$prebuilt" = 0 ]; then
    if ! command -v node >/dev/null 2>&1; then
      if [ "$brew" = 1 ]; then
        missing="$missing
  - Node.js 22 or newer, which builds the browser app: brew install node (or https://nodejs.org/)"
      else
        missing="$missing
  - Node.js 22 or newer, which builds the browser app: https://nodejs.org/"
      fi
    elif ! node -e 'const [a, b] = process.versions.node.split(".").map(Number); process.exit(a > 22 || (a === 22 && b >= 12) ? 0 : 1)'; then
      missing="$missing
  - A newer Node.js: LoomWatch needs 22.12 or newer and this computer has $(node --version).
    Install the current version from https://nodejs.org/"
    fi

    if ! command -v cargo >/dev/null 2>&1; then
      missing="$missing
  - Rust, which builds the LoomWatch program. Install it with:
      curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y"
    fi
  fi

  if [ -n "$missing" ]; then
    printf '\n%sLoomWatch needs a few things installed first:%s\n%s\n\n' "$bold" "$reset" "$missing" >&2
    say "When they are installed, open a new terminal window and run $self again." >&2
    exit 1
  fi

  if ! command -v python3 >/dev/null 2>&1; then
    if is_macos; then
      say "Note: the offline demo team needs Python 3. Install it with: xcode-select --install"
    else
      say "Note: the offline demo team needs Python 3."
    fi
  fi
}

random_secret() {
  head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n'
}

ensure_env_file() {
  [ -f .env ] && return 0
  [ -f .env.example ] || fail ".env.example is missing from $repo_root. Download LoomWatch again."
  # Another PostgreSQL on the usual port is common enough to step around instead of failing on.
  local db_port=5433
  while port_in_use "$db_port" && [ "$db_port" -lt 5460 ]; do db_port=$((db_port + 1)); done
  sed -e "s/^POSTGRES_PASSWORD=.*/POSTGRES_PASSWORD=$(random_secret)/" \
    -e "s/^POSTGRES_PORT=.*/POSTGRES_PORT=$db_port/" \
    -e "s/^LOOMWATCH_HOST_RUNNER_TOKEN=.*/LOOMWATCH_HOST_RUNNER_TOKEN=$(random_secret)/" \
    .env.example >.env
  if [ "$prebuilt" = 1 ]; then
    # Compose names a project after its folder, and this one is called just `app`, like many other
    # projects whose database this would otherwise take over. Compose reads the name from .env.
    printf '\n# The Docker Compose project that holds the database.\nCOMPOSE_PROJECT_NAME=loomwatch-app\n' >>.env
  fi
  chmod 600 .env
  say "Created your settings file (.env) with a random database password."
}

# Fails before the long build, not after it, when the database's port belongs to something else.
check_database_port() {
  uses_docker_database || return 0
  local db_port
  db_port=$(env_value POSTGRES_PORT)
  port_in_use "${db_port:-5433}" || return 0
  if docker info >/dev/null 2>&1 && [ -n "$(docker compose ps --status running --quiet postgres 2>/dev/null)" ]; then
    return 0
  fi
  fail "another program is using port ${db_port:-5433}, which the LoomWatch database needs. Change POSTGRES_PORT in $(where_is .env) to a free port such as $((${db_port:-5433} + 1)), then run $self again."
}

ensure_teams_root() {
  [ -d "$teams_root" ] && return 0
  mkdir -p "$teams_root"
  cp examples/operator-stop.yaml examples/operator-stop-harness.py "$teams_root/"
  say "Created your teams folder at $teams_root, with an offline demo team in it."
}

# Asks Docker Desktop to start without waiting, so it boots while LoomWatch builds.
wake_docker() {
  uses_docker_database || return 0
  docker info >/dev/null 2>&1 && return 0
  local app
  if is_macos && app=$(docker_app); then
    say "Starting $(basename "$app" .app). If it asks you to accept its terms, do that and LoomWatch will carry on."
    open -a "$app"
  fi
}

start_database() {
  if ! uses_docker_database; then
    DATABASE_URL=$LOOMWATCH_DATABASE_URL
    return 0
  fi
  if ! docker info >/dev/null 2>&1; then
    if is_macos && docker_app >/dev/null; then
      say "Waiting for Docker to finish starting…"
      local waited=0
      until docker info >/dev/null 2>&1; do
        [ "$waited" -ge 120 ] && fail "Docker did not start within two minutes. Open Docker Desktop, wait until it says it is running, then run $self again."
        sleep 2
        waited=$((waited + 2))
      done
    else
      fail "Docker is not running. Start Docker, then run $self again."
    fi
  fi

  local user password db db_port
  user=$(env_value POSTGRES_USER)
  password=$(env_value POSTGRES_PASSWORD)
  db=$(env_value POSTGRES_DB)
  db_port=$(env_value POSTGRES_PORT)
  step "Starting the database"
  if ! docker compose up --detach --wait postgres; then
    fail "the database did not start. If the message above says port ${db_port:-5433} is already in use, change POSTGRES_PORT in $(where_is .env) to a free port such as $((${db_port:-5433} + 1)), then run $self again."
  fi
  match_database_password
  DATABASE_URL="postgres://$user:$password@127.0.0.1:${db_port:-5433}/$db"
}

# PostgreSQL keeps the password it was created with, and Compose names the database after this
# folder. So LoomWatch downloaded again into a folder named like an earlier copy finds that copy's
# database, which refuses the new random password in .env. The database is LoomWatch's own and
# its history goes with the teams every copy shares, so it takes this folder's password instead.
match_database_password() {
  local refused
  # Inside the container a connection through its network address is password-checked exactly
  # like LoomWatch's own; one through the local socket is trusted, which is what lets this fix it.
  refused=$(docker compose exec -T postgres sh -c \
    'PGPASSWORD=$POSTGRES_PASSWORD psql -h "$(hostname)" -U "$POSTGRES_USER" -d postgres -tAc "select 1"' 2>&1 >/dev/null) &&
    return 0
  case $refused in
    *'password authentication failed'*) ;;
    *) return 0 ;; # Anything else is left for LoomWatch itself to report.
  esac
  if docker compose exec -T postgres sh -c \
    'psql -v ON_ERROR_STOP=1 -v user="$POSTGRES_USER" -v password="$POSTGRES_PASSWORD" -U "$POSTGRES_USER" -d postgres -q' \
    >/dev/null <<'SQL'; then
ALTER ROLE :"user" WITH PASSWORD :'password';
SQL
    say "Found the database of an earlier LoomWatch copy on this computer. It now uses the password in this folder's .env, so its run history is kept."
    return 0
  fi
  fail "the database Docker kept from an earlier LoomWatch copy refuses the password in $(where_is .env), and LoomWatch could not change it. To start over with an empty run history, run: $(in_this_folder)docker compose down --volumes (this deletes the earlier history; your teams are kept), then $self again."
}

# What the build depends on: the commit plus any local edits. An unchanged checkout never rebuilds.
source_fingerprint() {
  if command -v git >/dev/null 2>&1 && git rev-parse --git-dir >/dev/null 2>&1; then
    local paths='ui crates migrations schemas Cargo.toml Cargo.lock rust-toolchain.toml'
    # shellcheck disable=SC2086 # the path list is split on purpose
    {
      git rev-parse HEAD
      git status --porcelain -- $paths
      git diff HEAD -- $paths
    } | cksum
  else
    echo unversioned
  fi
}

build_if_needed() {
  [ "$prebuilt" = 0 ] || return 0
  local fingerprint
  fingerprint=$(source_fingerprint)
  if [ "$force_rebuild" = 0 ] && [ -x "$binary" ] && [ "$(cat "$build_stamp" 2>/dev/null)" = "$fingerprint" ]; then
    return 0
  fi
  step "Building LoomWatch (the first build takes a few minutes)"
  # The browser app is built first: it is packed into the LoomWatch program.
  (cd ui && npx --yes pnpm@12 install --frozen-lockfile && npx --yes pnpm@12 run build) ||
    fail "the browser app did not build. The messages above say why."
  cargo build --release --locked --bin loomwatchd ||
    fail "the LoomWatch program did not build. The messages above say why."
  printf '%s\n' "$fingerprint" >"$build_stamp"
}

start() {
  if loomwatch_is_running; then already_running; fi
  if port_in_use "$port"; then
    fail "another program is using port $port. Start LoomWatch on a different port with: LOOMWATCH_PORT=$((port + 1)) $self"
  fi

  check_prerequisites
  ensure_env_file
  ensure_teams_root
  wake_docker
  check_database_port
  build_if_needed
  start_database

  export DATABASE_URL
  # Compose-mode settings in the operator's own shell would point this native daemon at a
  # container runner or a container-only capability folder.
  unset LOOMWATCH_CAPABILITY_HOME LOOMWATCH_HOST_RUNNER_ADDR LOOMWATCH_HOST_RUNNER_TOKEN
  # Which checkout is running, for the "Send feedback" report. `-dirty` marks local edits. A
  # ready-built copy names the commit its release was built from, in VERSION.
  if [ "$prebuilt" = 1 ]; then
    LOOMWATCH_COMMIT=$(cut -d ' ' -f 2 VERSION 2>/dev/null || true)
  else
    LOOMWATCH_COMMIT=$(git describe --always --dirty --abbrev=7 2>/dev/null || true)
  fi
  export LOOMWATCH_COMMIT

  # Open the browser once the server answers. This runs beside the daemon, which replaces this
  # script below so Ctrl-C reaches it exactly as if it had been started by hand.
  (
    for _ in $(seq 1 120); do
      if loomwatch_is_running; then
        open_url "$url"
        exit 0
      fi
      sleep 0.5
    done
  ) &

  step "LoomWatch is starting at $url"
  say "Your teams are in $teams_root"
  say "Keep this window open while you use LoomWatch. Press Ctrl-C to stop it."
  mkdir -p "$state_dir"
  echo "$$" >"$pid_file"
  exec "./$binary" serve --teams-root "$teams_root" --listen "127.0.0.1:$port"
}

# Sends a signal to LoomWatch's whole process group, as Ctrl-C would, so running agents stop with
# it, then waits up to ten seconds. True when it has stopped.
signal_and_wait() {
  local signal=$1 pid=$2 pgid=$3
  if [ "$pgid" = "$pid" ]; then kill "-$signal" -- "-$pid" 2>/dev/null || true; else kill "-$signal" "$pid" 2>/dev/null || true; fi
  for _ in $(seq 1 20); do
    kill -0 "$pid" 2>/dev/null || return 0
    sleep 0.5
  done
  ! kill -0 "$pid" 2>/dev/null
}

stop() {
  failure_heading='LoomWatch could not stop'
  local pid pgid stopped=0
  pid=$(cat "$pid_file" 2>/dev/null || true)
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    case $(ps -p "$pid" -o comm= 2>/dev/null) in
      *loomwatchd*)
        pgid=$(ps -p "$pid" -o pgid= | tr -d ' ')
        # One started in the background ignores Ctrl-C's signal, so it is then asked to end.
        if ! signal_and_wait INT "$pid" "$pgid" && ! signal_and_wait TERM "$pid" "$pgid"; then
          fail "LoomWatch (process $pid) is still running. Stop it with: kill -9 $pid"
        fi
        stopped=1
        say "Stopped LoomWatch."
        ;;
    esac
  fi
  rm -f "$pid_file"
  if [ "$stopped" = 0 ] && loomwatch_is_running; then
    local other
    other=$(listener_pid "$port" || true)
    if [ -n "$other" ]; then
      say "LoomWatch at $url was not started by $self in this folder. It is process $other, from $(process_folder "$other" || true). Press Ctrl-C in the window running it, or run: kill $other"
    else
      say "LoomWatch at $url was not started by $self. Press Ctrl-C in the window running it."
    fi
  fi

  if uses_docker_database && command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    docker compose stop postgres
    say "Stopped the database. Your teams and history are kept."
  fi
}

update() {
  failure_heading='LoomWatch could not update'
  if loomwatch_is_running; then
    fail "it is still running. Stop it first (press Ctrl-C in its window, or run $self stop), then run $self update."
  fi
  if [ "$prebuilt" = 1 ]; then
    # The installer that put this copy here fetches the newest release and replaces it in place;
    # this script keeps running from the copy it started as, then hands over to the new one.
    bash ./install.sh --update --dir "$repo_root" || fail "the download did not finish. The messages above say why."
    if [ "$open_browser" = 0 ]; then exec "$repo_root/loomwatch" start --no-open; fi
    exec "$repo_root/loomwatch" start
  fi
  command -v git >/dev/null 2>&1 || fail "updating needs Git. Install it with: xcode-select --install"
  step "Downloading the latest LoomWatch"
  git pull --ff-only ||
    fail "the download did not finish. If Git says your local changes would be overwritten, ask whoever changed files in this folder before discarding them."
  failure_heading='LoomWatch could not start'
  start
}

usage() {
  local start_does='Set up anything missing, build if needed, start LoomWatch and open it (the default)'
  local update_does='Download the latest LoomWatch, rebuild it and start it' rebuild_option='
  --rebuild   Build again even if nothing changed'
  if [ "$prebuilt" = 1 ]; then
    start_does='Set up anything missing, start LoomWatch and open it (the default)'
    update_does='Download and install the newest release, then start it'
    rebuild_option=
  fi
  cat <<EOF
Usage: $self [command] [options]

Commands:
  start     $start_does
  update    $update_does
  stop      Stop LoomWatch and its database. Your teams and history are kept.
  help      Show this help

Options:
  --no-open   Do not open the browser$rebuild_option

Settings (environment variables):
  LOOMWATCH_TEAMS_ROOT     Where your teams live (now: $teams_root)
  LOOMWATCH_PORT           Browser port (now: $port)
  LOOMWATCH_DATABASE_URL   Use your own PostgreSQL instead of the one in Docker
EOF
}

case $command in
  start) start ;;
  update) update ;;
  stop) stop ;;
  help) usage ;;
esac
